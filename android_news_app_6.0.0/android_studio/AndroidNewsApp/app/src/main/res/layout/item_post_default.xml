<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lyt_parent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:foreground="?selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/item_post_padding_medium"
    android:layout_marginBottom="2dp">

    <RelativeLayout
        android:layout_width="@dimen/post_thumbnail_width"
        android:layout_height="@dimen/post_thumbnail_height">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@color/color_shimmer"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Image.Rounded" />

        <ImageView
            android:id="@+id/thumbnail_video"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_centerInParent="true"
            android:alpha="0.9"
            android:src="@drawable/ic_thumbnail_video"
            android:visibility="gone" />

    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:fontFamily="@font/custom_font"
            android:text="News Title"
            android:textColor="@color/color_light_text"
            android:textSize="@dimen/post_primary_font_size"
            android:textStyle="bold"
            android:lineSpacingMultiplier="1.2" />

        <TextView
            android:id="@+id/excerpt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:fontFamily="@font/custom_font"
            android:text="short description"
            android:textColor="@color/color_light_text_secondary"
            android:textSize="@dimen/post_secondary_font_size"
            android:lineSpacingMultiplier="1.3" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/lyt_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ic_date"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_time"
                    app:tint="@color/color_grey_medium" />

                <TextView
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/custom_font"
                    android:text="2 weeks ago"
                    android:textColor="@color/color_grey_medium"
                    android:textSize="@dimen/post_secondary_font_size" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/lyt_comment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginEnd="4dp">

                <ImageView
                    android:id="@+id/ic_comment"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_comment"
                    android:visibility="gone"
                    app:tint="@color/color_grey_medium" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_comment"
                    app:tint="@color/color_grey_medium" />

                <TextView
                    android:id="@+id/comment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/custom_font"
                    android:text="2"
                    android:textColor="@color/color_grey_medium"
                    android:textSize="@dimen/post_secondary_font_size" />

            </LinearLayout>

            <ImageView
                android:id="@+id/btn_overflow"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:src="@drawable/ic_dots"
                app:tint="@color/color_grey_medium" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>

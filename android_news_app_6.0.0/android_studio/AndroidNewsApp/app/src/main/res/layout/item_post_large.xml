<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/item_post_padding_medium"
    android:layout_marginEnd="@dimen/item_post_padding_medium"
    android:layout_marginTop="@dimen/item_post_padding_medium"
    android:layout_marginBottom="@dimen/item_post_padding_small"
    app:cardBackgroundColor="@color/color_light_card"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardMaxElevation="4dp"
    app:cardPreventCornerOverlap="true">

    <LinearLayout
        android:id="@+id/lyt_parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:foreground="?selectableItemBackground"
        android:orientation="vertical">

        <!-- Full-width image with top-rounded corners -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/image"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:background="@color/color_shimmer" />

            <!-- Gradient scrim over image bottom -->
            <View
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_alignBottom="@id/image"
                android:background="@drawable/bg_gradient_soft" />

            <ImageView
                android:id="@+id/thumbnail_video"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:alpha="0.9"
                android:src="@drawable/ic_thumbnail_video"
                android:visibility="gone" />

        </RelativeLayout>

        <!-- Content area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:fontFamily="@font/custom_font"
                android:text="Sample Title"
                android:textColor="@color/color_light_text"
                android:textSize="@dimen/post_heading_font_size"
                android:textStyle="bold"
                android:lineSpacingMultiplier="1.2" />

            <TextView
                android:id="@+id/excerpt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:fontFamily="@font/custom_font"
                android:text="travel"
                android:textColor="@color/color_light_text_secondary"
                android:textSize="@dimen/post_secondary_font_size"
                android:lineSpacingMultiplier="1.3" />

            <!-- Metadata row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/lyt_date"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ic_date"
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:src="@drawable/ic_time"
                        app:tint="@color/color_grey_medium" />

                    <TextView
                        android:id="@+id/date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/custom_font"
                        android:text="2 weeks ago"
                        android:textColor="@color/color_grey_medium"
                        android:textSize="@dimen/post_secondary_font_size" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lyt_comment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginEnd="4dp">

                    <ImageView
                        android:id="@+id/ic_comment"
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:src="@drawable/ic_comment"
                        android:visibility="gone"
                        app:tint="@color/color_grey_medium" />

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:src="@drawable/ic_comment"
                        app:tint="@color/color_grey_medium" />

                    <TextView
                        android:id="@+id/comment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/custom_font"
                        android:text="2"
                        android:textColor="@color/color_grey_medium"
                        android:textSize="@dimen/post_secondary_font_size" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/btn_overflow"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?selectableItemBackgroundBorderless"
                    android:padding="4dp"
                    android:src="@drawable/ic_dots"
                    app:tint="@color/color_grey_medium" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
